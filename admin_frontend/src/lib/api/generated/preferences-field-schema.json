  "knowledge.answering.prompt": {
    "path": "knowledge.answering.prompt",
    "nullable": false,
    "type": "string",
    "default": "Use the provided knowledge context as your only source of facts; do not invent or assume anything that is not supported by it.\n\nAnswer every part of the question that the context supports. Partial answers are expected and welcome \u2014 never withhold a supported part just because another part is unsupported.\n\nIf a part of the question is not covered by the context, give the parts you can and briefly note what is missing. Do not reply with only 'I don't know' when any part of the question is supported by the context."
  },
