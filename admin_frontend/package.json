{
  "name": "@hiroleague/admin-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "npm run kit && vite --host 127.0.0.1",
    "build": "npm run kit && svelte-kit sync && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "gen:prefs-types": "node scripts/gen-preferences-types.mjs",
    "check:prefs-types": "node scripts/check-preferences-types.mjs",
    "gen:features": "node scripts/gen-features-registry.mjs",
    "check:features": "node scripts/check-features-registry.mjs",
    "check": "npm run check:prefs-types && npm run check:features && npm run check:svelte",
    "check:svelte": "npm run kit && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "npm run kit && node scripts/run-vitest.mjs run",
    "package:python": "npm run build",
    "kit": "node scripts/kit-sync.mjs"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.47.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.6.0",
    "json-schema-to-typescript": "^15.0.4",
    "mode-watcher": "^1.1.0",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.3.3",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@hiroleague/ui": "file:../ui-kit",
    "@tanstack/svelte-table": "^9.0.0-alpha.38",
    "bits-ui": "^2.19.3",
    "clsx": "^2.1.1",
    "d3-force-3d": "^3.0.6",
    "dompurify": "^3.4.2",
    "force-graph": "^1.51.4",
    "marked": "^18.0.3",
    "tailwind-merge": "^3.7.0"
  }
}
