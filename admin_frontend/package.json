{
  "name": "@hiroleague/admin-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "gen:prefs-types": "node scripts/gen-preferences-types.mjs",
    "check:prefs-types": "node scripts/check-preferences-types.mjs",
    "gen:features": "node scripts/gen-features-registry.mjs",
    "check:features": "node scripts/check-features-registry.mjs",
    "check": "npm run check:prefs-types && npm run check:features && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "node scripts/run-vitest.mjs run",
    "package:python": "npm run build"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.1",
    "@lucide/svelte": "^1.16.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.49.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^25.6.0",
    "json-schema-to-typescript": "^15.0.4",
    "shadcn-svelte": "^1.2.7",
    "svelte": "^5.43.14",
    "svelte-check": "^4.3.3",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@tanstack/svelte-table": "^9.0.0-alpha.38",
    "bits-ui": "^2.18.0",
    "clsx": "^2.1.1",
    "d3-force-3d": "^3.0.6",
    "dompurify": "^3.4.2",
    "force-graph": "^1.51.4",
    "marked": "^18.0.3",
    "tailwind-merge": "^3.5.0"
  }
}
