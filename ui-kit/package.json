{
	"name": "@hiroleague/ui",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "The shared UI kit of the Hiro apps: the Hiro theme, shadcn's components, the app shell, state helpers and formatting. Read as source by the apps ($kit), which install it as a copy from this folder.",
	"files": [
		"src/lib"
	],
	"peerDependencies": {
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.47.0",
		"@sveltejs/kit": "^2.63.0",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.0",
		"mode-watcher": "^1.1.0",
		"svelte": "^5.56.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && eslint . && vitest run",
		"lint": "eslint .",
		"test": "vitest run"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.47.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"bits-ui": "^2.19.3",
		"clsx": "^2.1.1",
		"eslint": "^10.11.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"happy-dom": "^20.14.5",
		"mode-watcher": "^1.1.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.0.16",
		"vitest": "^5.0.2"
	}
}
