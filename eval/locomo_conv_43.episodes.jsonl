{"id": "locomo_conv_43_d12_1", "timestamp": "2023-10-02T15:00:00Z", "speaker": "Tim", "type": "text", "body": "Hey John! Awesome catchin' up with you! A lot's changed since last time.", "metadata": {"document_id": "locomo_conv_43", "document_title": "LoCoMo conv-43"}}
{"id": "locomo_conv_43_d12_2", "timestamp": "2023-10-02T15:00:01Z", "speaker": "John", "type": "text", "body": "Hey, Tim! Good to hear from you. Anyway, a lot has been going on with me. My girlfriend and I had an amazing and emotional wedding ceremony last week.", "metadata": {"document_id": "locomo_conv_43", "document_title": "LoCoMo conv-43"}}
