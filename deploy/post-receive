#!/usr/bin/env bash
# Server-side hook in ~/hiroleague.git (a bare repo on the server). `git push <server> main` from
# the PC checks main out into ~/hiroleague and runs deploy/deploy.sh; its output streams back to
# the pusher. Pushes to other branches are ignored.
# Install: the deploy guide, hiro-docs mintdocs/build/local-build/server-deploy.mdx ("First-time setup").
set -euo pipefail
unset GIT_DIR
DEPLOY_BRANCH=main
CHECKOUT="$HOME/hiroleague"
while read -r _old _new ref; do
  if [ "$ref" != "refs/heads/$DEPLOY_BRANCH" ]; then
    echo "hiroleague: ignoring $ref (only $DEPLOY_BRANCH deploys)"
    continue
  fi
  # The checkout is a git repo of its own, fetched from this bare repo by path. Why: the deploy then needs no
  # GIT_DIR, so nothing the checks run can inherit one and write into this bare repo (a test that ran `git init`
  # and committed under an exported GIT_DIR re-initialised it as a work tree and put its commits on main).
  # No remote is set, so the checkout has no origin/* refs: the check never takes its files as "already pushed".
  mkdir -p "$CHECKOUT"
  [ -d "$CHECKOUT/.git" ] || git -C "$CHECKOUT" -c init.defaultBranch=main init -q
  git -C "$CHECKOUT" fetch -q "$HOME/hiroleague.git" "refs/heads/$DEPLOY_BRANCH"
  git -C "$CHECKOUT" checkout -q -f --detach FETCH_HEAD
  # Files deleted from the repo must not linger in the work tree (check.sh and the build see it).
  # Ignored files (node_modules, .venv, the built admin UI) stay: no -x.
  git -C "$CHECKOUT" clean -fdq
  "$CHECKOUT/deploy/deploy.sh"
done
